pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Environment') {
            steps {
                dir('user_service') {
                    echo 'Checking build environment...'

                    sh '''
                        echo "Java version:"
                        java -version

                        echo ""
                        echo "Maven version:"
                        chmod +x mvnw
                        ./mvnw -version
                    '''
                }
            }
        }

        stage('Compile') {
            steps {
                dir('user_service') {
                    echo 'Compiling application...'
                    sh './mvnw clean compile'
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir('user_service') {
                    echo 'Running unit tests...'
                    sh './mvnw test'
                }
            }
        }

        stage('Dependency Check') {
            steps {
                dir('user_service') {
                    echo 'Running OWASP Dependency-Check...'

                    sh '''
                        ./mvnw org.owasp:dependency-check-maven:check \
                            -DskipTests
                    '''
                }
            }
        }

        stage('Package') {
            steps {
                dir('user_service') {
                    echo 'Packaging application...'
                    sh './mvnw package -DskipTests'
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts(
                    artifacts: 'user_service/target/*.jar',
                    fingerprint: true
                )
            }
        }

        stage('Archive Security Report') {
            steps {
                archiveArtifacts(
                    artifacts: 'user_service/target/dependency-check-report.*',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }
    }

    post {
        always {
            junit(
                testResults: 'user_service/target/surefire-reports/*.xml',
                allowEmptyResults: true
            )

            cleanWs()
        }

        success {
            echo '''
========================================
BUILD SUCCESSFUL
========================================
Ride Hailing User Service
Branch: development
Security scan: Completed
Application packaged successfully
========================================
'''
        }

        failure {
            echo '''
========================================
BUILD FAILED
========================================
Check the Jenkins console output.
========================================
'''
        }
    }
}